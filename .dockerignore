# Only the application goes into the image. Anything site-specific or secret
# stays out: environment files, override compose files (network details),
# backups and dumps, editor and assistant folders, docs, tests and host scripts.

# Version control, CI, editors and assistants
.git
.github
.claude
.codex
.cursor
.idea
.vscode
.zed
.nova
.phpactor.json

# Secrets and site configuration
.env
.env.*
auth.json
compose*.yml
compose*.yaml

# Backups, dumps and archives
backups
*.dump
*.sql
*.sql.gz
*.tgz
*.tar
*.tar.gz
*.zip

# Not needed at runtime (installed or built in the image, or host-side)
vendor
node_modules
probe
docs
tests
bin
phpunit.xml
.phpunit.cache
.phpunit.result.cache
*.log

# Runtime state, created by the container on its volume
storage/logs/*
storage/framework/*
storage/app/private/*
storage/app/public/*
storage/pail
storage/*.key
database/*.sqlite
public/storage
public/hot

# Developer and assistant guidance
AGENTS.md
CLAUDE.md
boost.json
.ai
.mcp.json

# Bind-mounted data (database and storage)
data

# Generic host files shipped in the image, so installs without git can update them (bin/update).
# Only these: the site's own overrides (compose.proxy.yml, compose.vlan.yml) never go in.
!compose.yml
!compose.proxy.example.yml
!compose.vlan.example.yml
!bin
