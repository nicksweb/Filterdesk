#!/bin/sh
set -eu

# Works in a git checkout (bin/install) and in a plain install folder holding
# compose.yml and .env.example (sh install).
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$project_dir/.env.example" ] && [ -f "$PWD/.env.example" ]; then
    project_dir=$PWD
fi
env_file="$project_dir/.env"

if [ ! -f "$env_file" ]; then
    cp "$project_dir/.env.example" "$env_file"
fi

if grep -q '^APP_KEY=$' "$env_file"; then
    app_key=$(openssl rand -base64 32)
    sed -i "s|^APP_KEY=$|APP_KEY=base64:$app_key|" "$env_file"
fi

if grep -q '^DB_PASSWORD=$' "$env_file"; then
    db_password=$(openssl rand -hex 24)
    sed -i "s|^DB_PASSWORD=$|DB_PASSWORD=$db_password|" "$env_file"
fi

if grep -q '^PROBE_SHARED_KEY=$' "$env_file"; then
    probe_key=$(openssl rand -hex 32)
    sed -i "s|^PROBE_SHARED_KEY=$|PROBE_SHARED_KEY=$probe_key|" "$env_file"
fi
chmod 600 "$env_file"

mkdir -p "$project_dir/data"
echo "Configuration created at $env_file; data will be kept in $project_dir/data"
echo "Review APP_URL, TRUSTED_PROXIES and FILTERDESK_VERSION, then run: docker compose pull && docker compose up -d"
echo "Behind a reverse proxy in Docker, set TRUSTED_PROXIES to the shared network's subnet:"
echo "  docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' <proxy network>"
echo "or pages link to http:// stylesheets and appear unstyled. The wizard's first page checks this."
