APP_NAME="Filterdesk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://filterdesk.example.edu.au
APP_TIMEZONE=Australia/Brisbane
APP_LOCALE=en
TRUSTED_PROXIES=127.0.0.1
APP_PORT=8088

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filterdesk
DB_USERNAME=filterdesk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=filterdesk@example.edu.au
MAIL_FROM_NAME="Filterdesk"

PROBE_SHARED_KEY=
PROBE_TIMEOUT_MS=8000
# Extra wait after a page loads, before its screenshot (ms).
PROBE_SETTLE_MS=1500
BLOCK_PAGE_PATTERN="blocked|access denied|not permitted|content filter|unifi"
STUDENT_ALLOWED_PRIVATE_HOSTS=
STAFF_ALLOWED_PRIVATE_HOSTS=
# DNS freshness: query each VLAN's filtering resolver directly (no cache).
# Set these to the UniFi gateway address for each access network.
STUDENT_PROBE_DNS_SERVERS=
STAFF_PROBE_DNS_SERVERS=
# Addresses UniFi's DNS filter answers with for blocked names (0.0.0.0 is always treated as blocked).
BLOCK_PAGE_ADDRESSES=
# Keep false so every check run starts a fresh browser with an empty DNS cache.
PROBE_REUSE_BROWSER=false

STUDENT_DOCKER_NETWORK=student_access_vlan
STAFF_DOCKER_NETWORK=staff_access_vlan

# Published images to run (ghcr.io/nicksweb/filterdesk-app, -web, -probe):
# latest, a month (2026.12) or an exact release (2026.12.1). Use local with compose.build.yml.
FILTERDESK_VERSION=latest
# Installs from before the rename to Filterdesk: keep the old project name so
# the database volume and container names stay the same.
# COMPOSE_PROJECT_NAME=it-edu-selfservice

# How many people can use the app at once. A website check holds one worker
# for its whole run (a few seconds); about 40 MB of memory each.
# PHP_FPM_MAX_CHILDREN=20
# How many checks each probe runs at once (one browser each), and how long
# extra checks wait for a turn before being told the probe is busy.
# PROBE_MAX_CONCURRENT=6
# PROBE_QUEUE_TIMEOUT_MS=20000
